datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Tabela de Usuários (necessária para o login no futuro)
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  tasks    Task[]
}

// 2. Tabela de Tarefas (sua To-Do List)
model Task {
  id     Int     @id @default(autoincrement())
  title  String
  done   Boolean @default(false)
  userId Int
  user   User    @relation(fields: [userId], references: [id])
}